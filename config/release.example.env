# 仅发行者配置；不会由 CLI 自动 source。没有凭据/私钥/账户邮箱/设备清单。
# 使用前复制为 private 文件并改成实际值；变量必须 export。
export CUBIC_COMMIT='REPLACE_WITH_FULL_40_HEX_COMMIT'
export CUBIC_TEAM_ID='REPLACE_WITH_LEGAL_TEAM_ID'
export CUBIC_IOS_BUNDLE_ID='local.liwei.Cubic'
export CUBIC_MACOS_BUNDLE_ID='local.liwei.CubicMac'
export CUBIC_VERSION='0.2.1'
export CUBIC_BUILD_NUMBER='3'
# 0.2.1/3 只是参数示例；检查渠道已上传记录后确定递增 build。
export CUBIC_OUTPUT_DIR="${TMPDIR:-/tmp}/Cubic Release Candidates"
export CUBIC_PLATFORM='macos'
export CUBIC_RELEASE_CHANNEL='developer-id'
export CUBIC_SIGNING_IDENTITY='REPLACE_WITH_CERTIFICATE_SHA1'
# iOS 另需显式 development archive 与 distribution export 两套已安装资产。
# export CUBIC_ARCHIVE_IDENTITY='REPLACE_WITH_DEVELOPMENT_CERT_SHA1'
# export CUBIC_ARCHIVE_PROFILE='/private/path/archive.mobileprovision'
# export CUBIC_DISTRIBUTION_PROFILE='/private/path/distribution.mobileprovision'
# Ad Hoc 仅 private JSON 字符串数组，不提交 Git，不放公开 manifest。
# export CUBIC_DEVICES_JSON='/private/path/devices.json'
# 仅 package --notary 使用预先配置的 Keychain profile；CLI 不保存密码。
# export CUBIC_NOTARY_PROFILE='Cubic-notary'
